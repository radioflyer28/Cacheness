#!/bin/sh
# Pre-commit hook for Cacheness
# Auto-fixes code (Phase 1) and logs errors (Phase 2)
# NOTE: No `set -e` — Phase 1 must never abort the commit.

echo "Running pre-commit quality checks..."

# Collect staged .py files (Added, Copied, Modified, Renamed)
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')

if [ -z "$STAGED_PY" ]; then
    echo "No staged .py files — skipping quality checks."
    exit 0
fi

# Phase 1: Auto-fix staged files, then re-stage so the commit
# captures the formatted versions (never fails — || true guards)
echo "Phase 1: Auto-fixing code..."
echo "$STAGED_PY" | xargs uv run ruff format 2>&1 || true
echo "$STAGED_PY" | xargs uv run ruff check --fix 2>&1 || true

# Re-stage any files that Phase 1 modified
echo "$STAGED_PY" | xargs git add

# Phase 2: Validation (logs errors but doesn't block)
echo "Phase 2: Validating code..."
LOG_FILE=".quality-errors.log"

# Clear previous error log
> "$LOG_FILE"

{
    echo "=== Quality Check Errors ($(date)) ==="
    echo ""

    echo "--- Ruff Linting ---"
    echo "$STAGED_PY" | xargs uv run ruff check 2>&1 || true
    echo ""

    echo "--- Type Checking ---"
    echo "$STAGED_PY" | xargs uv run ty check 2>&1 || true
    echo ""
} > "$LOG_FILE" 2>&1

# Check if there were any errors
if grep -q "error\|Error\|ERROR" "$LOG_FILE"; then
    echo "⚠️  Quality issues found - logged to .quality-errors.log"
    echo "Commit proceeding (errors are warnings only)"
else
    echo "✅ No quality issues found"
    rm -f "$LOG_FILE"
fi

exit 0
